# Copy to .env at the project root. SQLite works without Firebase credentials.
DB_PROVIDER=sqlite
# To use the cloud, set DB_PROVIDER=firebase and fill these values:
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
# Absolute path to a service account file OUTSIDE this repository and APK.
GOOGLE_APPLICATION_CREDENTIALS=
API_PORT=3001
API_HOST=127.0.0.1

# Public HTTPS address embedded in the Android build after the API is deployed.
# This is a public URL, never a password or a Firebase service account key.
# VITE_API_SERVER_URL=https://your-real-service-url.run.app

# Free hosting: Render + Firestore Spark + Cloudinary.
# Set PHOTO_PROVIDER=cloudinary only after filling all Cloudinary credentials.
# PHOTO_PROVIDER=cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Render: paste the Firebase service account JSON as a SECRET environment variable.
# Locally keep GOOGLE_APPLICATION_CREDENTIALS pointing to the existing private file.
FIREBASE_SERVICE_ACCOUNT_JSON=
